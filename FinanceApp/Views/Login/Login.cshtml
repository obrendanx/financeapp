@model FinanceApp.ViewModels.UserLogin
@if (ViewData.Keys.Contains("message"))
{
    <p>
        @ViewData["message"]
    </p>
}
<div class="wrapper">
    <h1>Welcome, Please login to continue...</h1>
    <!--<a class="loginBtn" asp-action="ExternalLogin" asp-route-provider="Microsoft">Microsoft Sign In</a>-->

    <form asp-action="LoginUser" asp-controller="Login" method="post">
        <div class="form-group">
            <input type="text" asp-for="Username" class="form-control" placeholder="Please enter your username"/>
            <span asp-validation-for="Password" class="text-danger"></span><br/>
            
            <input type="password" asp-for="Password" class="form-control" placeholder="Please enter your password"/>
            <span asp-validation-for="Password" class="text-danger"></span><br/>
            
            <input class="btn btn-primary" type="submit"/>
        </div>
    </form>
</div>